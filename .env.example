# Copie para .env (o comando `npm run keygen` cria um .env automaticamente se ele não existir).
# NUNCA versione o .env. Em produção, estes valores vêm do Secret Manager.

# Cluster: o MVP só aceita devnet.
SOLANA_CLUSTER=devnet
# RPC público da Devnet (pode limitar requisições). Troque por um RPC dedicado antes da demo.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Carteira exclusiva da Devnet (gerada por `npm run keygen`).
SOLANA_KEYPAIR_PATH=secrets/devnet-wallet.json
# Nível de confirmação exigido para marcar "anchored" e para verificar: confirmed | finalized
POG_COMMITMENT=finalized

# Identificador bruto do dispositivo (ex.: o MAC que aparece no nome do arquivo de export).
# Fica só aqui; nunca aparece em payload, log, nome de arquivo compartilhado ou URL.
POG_DEVICE_ID=
# Segredo HMAC do pseudônimo (64 caracteres hex = 32 bytes). Gerado por `npm run keygen`.
POG_PSEUDONYM_SECRET=
# Versão da chave do pseudônimo (para rotação futura; vai só no manifesto privado).
POG_PSEUDONYM_KEY_VERSION=1
